# Environment and secrets
.env
.env.*
!**/.env.example

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local model and data directories (anchored to repo root to avoid ignoring same-named dirs in source)
/temp-files/
/models/
/data/
/uploads/
/outputs/

# Local debugging and learning scratch (never part of the shipped project)
test/
playground/

# IDE and OS files
.idea/
.vscode/
.qoder/
.DS_Store
Thumbs.db

# Logs and local databases
*.log
*.sqlite
*.sqlite3

# Build artifacts
dist/
build/
*.egg-info/
node_modules/
*.tsbuildinfo

# Runtime storage generated by document uploads and import processing
storage/

# Temporary files and directories
tmp/
*.tmp

# Local test chunk exports (根目录下的 chunks 临时文件)
/chunks*.json

# Document import backup produced by _step_6_backup (contains full source text)
chunks-kb-*.json

# Python coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# PyInstaller
*.manifest
*.spec

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pyright
.pyright/

# NOTE: alembic.ini 必须提交（它声明 script_location，缺失会导致 alembic upgrade head 失败）；
# 数据库地址由 backend/alembic/env.py 从 .env 注入，alembic.ini 内不含任何凭证。